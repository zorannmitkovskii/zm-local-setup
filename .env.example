# Copy to .env to override defaults. Compose reads .env automatically.

# nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Postgres (root super-user)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# Keycloak
KEYCLOAK_PORT=8181
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Confidential admin client seeded into the master realm by keycloak-bootstrap,
# used by zm-iam-service to reach the Keycloak Admin API.
IAM_ADMIN_CLIENT_ID=zm-admin-cli
IAM_ADMIN_CLIENT_SECRET=zm-admin-secret

# Application service ports (host side)
IAM_PORT=8383
IVY_BE_PORT=8081
IVY_FE_PORT=5173

# ivy-events-be
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
STORAGE_PROVIDER=local
S3_BUCKET=ivy-events
AWS_REGION=eu-central-1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# admin-service client ivy-events-be uses (created by ivy on first boot).
IVY_KEYCLOAK_CLIENT_ID=admin-service
IVY_KEYCLOAK_CLIENT_SECRET=

# ── IAM provisioning (iam-manifest.yml) ─────────────────────────────
# Hostname the manifest interpolates into eventFE redirect/web-origin URIs.
# Has a compose default (localhost:5173); override only for a custom FE port.
APP_DOMAIN=localhost:5173
# Google IdP creds the manifest references by name. IAM resolves these from
# its OWN env when applying the google identity provider — they MUST be
# non-blank or the whole manifest apply rolls back (eventFE won't be created).
# Any non-empty string satisfies provisioning; use the real dev creds if you
# want Google login to actually work locally.
IVY_GOOGLE_CLIENT_ID=
IVY_GOOGLE_CLIENT_SECRET=

# ivy-events-fe
VITE_GOOGLE_MAPS_API_KEY=
